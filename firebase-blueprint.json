{
  "entities": {
    "UserRecord": {
      "title": "UserRecord",
      "description": "Authenticated user account and persisted role (client, pro, or admin).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID."
        },
        "fullName": {
          "type": "string",
          "description": "Display name of the user."
        },
        "email": {
          "type": "string",
          "description": "User email address from Google Sign-In."
        },
        "phone": {
          "type": "string",
          "description": "Optional phone number."
        },
        "role": {
          "type": "string",
          "enum": ["client", "pro", "admin"],
          "description": "Stored user role. Non-admins may only hold client or pro."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED"],
          "description": "Account status moderated by admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "fullName", "email", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Read-only trusted administrator registry document.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Administrator Firebase Auth UID."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when admin privilege was provisioned."
        }
      },
      "required": ["userId"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Service category managed exclusively by administrators.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "iconKey": { "type": "string" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "description", "iconKey", "isActive", "sortOrder", "createdAt", "updatedAt"]
    },
    "ProfessionalProfile": {
      "title": "ProfessionalProfile",
      "description": "Service provider listing requiring admin approval before appearing in public search.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "ownerName": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "countryCode": { "type": "string" },
        "countryName": { "type": "string" },
        "department": { "type": "string" },
        "city": { "type": "string" },
        "neighborhood": { "type": "string" },
        "interventionZones": { "type": "string" },
        "phonePublic": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "profileImage": { "type": "string" },
        "primaryCategoryId": { "type": "string" },
        "verificationStatus": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
        },
        "rejectionReason": { "type": "string" },
        "publicationStatus": {
          "type": "string",
          "enum": ["PUBLISHED", "DRAFT", "ARCHIVED"]
        },
        "openingHours": { "type": "string" },
        "consentGiven": { "type": "boolean" },
        "viewsCount": { "type": "integer" },
        "whatsappClicksCount": { "type": "integer" },
        "phoneClicksCount": { "type": "integer" },
        "isSponsored": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "businessName", "slug", "description", "countryCode", "countryName",
        "city", "neighborhood", "phonePublic", "whatsappNumber", "primaryCategoryId",
        "verificationStatus", "publicationStatus", "consentGiven",
        "viewsCount", "whatsappClicksCount", "phoneClicksCount", "isSponsored",
        "createdAt", "updatedAt"
      ]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Service offered by a professional under their profile.",
      "type": "object",
      "properties": {
        "professionalId": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "categoryId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "indicativePrice": { "type": "number" },
        "currencyCode": { "type": "string" },
        "pricingType": { "type": "string", "enum": ["SUR_DEVIS", "FIXED", "STARTING_AT"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["professionalId", "ownerUserId", "categoryId", "title", "description", "indicativePrice", "currencyCode", "pricingType", "isActive", "createdAt", "updatedAt"]
    },
    "PortfolioPhoto": {
      "title": "PortfolioPhoto",
      "description": "Portfolio image uploaded via Photo Picker for a professional profile.",
      "type": "object",
      "properties": {
        "professionalId": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "caption": { "type": "string" },
        "visible": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["professionalId", "ownerUserId", "imageUrl", "caption", "visible", "createdAt"]
    },
    "ReviewItem": {
      "title": "ReviewItem",
      "description": "Customer rating and review for an approved professional.",
      "type": "object",
      "properties": {
        "professionalId": { "type": "string" },
        "authorUserId": { "type": "string" },
        "authorName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "moderationStatus": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["professionalId", "authorUserId", "authorName", "rating", "comment", "moderationStatus", "createdAt"]
    },
    "ReportRecord": {
      "title": "ReportRecord",
      "description": "User-submitted report against a professional profile, moderated exclusively by admins.",
      "type": "object",
      "properties": {
        "reporterUserId": { "type": "string" },
        "reporterName": { "type": "string" },
        "reportedProfileId": { "type": "string" },
        "reason": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "RESOLVED", "DISMISSED", "SUSPENDED"] },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUserId", "reporterName", "reportedProfileId", "reason", "description", "status", "createdAt", "updatedAt"]
    },
    "AdminAuditLogRecord": {
      "title": "AdminAuditLogRecord",
      "description": "Immutable administrative action audit entry.",
      "type": "object",
      "properties": {
        "adminUserId": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminUserId", "action", "targetType", "targetId", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserRecord" },
      "description": "User accounts and roles isolated per user or admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only administrator access control list."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryItem" },
      "description": "Service categories readable by signed-in users and managed exclusively by admins."
    },
    "/professionals/{profileId}": {
      "schema": { "$ref": "#/entities/ProfessionalProfile" },
      "description": "Professional business listings. Only APPROVED profiles are searchable publicly."
    },
    "/professionals/{profileId}/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Services offered by a professional."
    },
    "/professionals/{profileId}/portfolio/{imageId}": {
      "schema": { "$ref": "#/entities/PortfolioPhoto" },
      "description": "Work portfolio photos uploaded by a professional."
    },
    "/professionals/{profileId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ReviewItem" },
      "description": "Customer reviews and star ratings."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReportRecord" },
      "description": "Profile reports submitted by users and reviewed exclusively by admins."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLogRecord" },
      "description": "Immutable administrative audit logs."
    }
  }
}
